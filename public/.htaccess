# Ask browsers to re-check pages, scripts and styles on every visit, so an updated page is never replaced by an
# older copy kept in the browser cache, and never runs against an older copy of a script it shares. A file that has
# not changed is answered with a short "not modified". Read by Apache-style hosts and LiteSpeed (scrapcraft.dev).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Browser protections for the pages and files. The app sends the same headers for its own
  # responses; the host serves the HTML pages directly, so they need them here too.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
