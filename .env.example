# Copy to .env for local development, or set these in the host environment
# (cPanel "Setup Node.js App" environment variables, or Windows system environment variables).
PORT=3000

# Signs staff login sessions. Use a long random value and keep it the same across restarts,
# or everyone gets signed out each time the app restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value

# Creates the first admin account automatically on first startup, if no admin exists yet.
# After you've signed in once with this account, remove these two lines (or change the password
# on the My account page) — they are only used when there is no admin account yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Leave empty at a domain root. Set to e.g. /virtual-queue when served under a sub-path.
BASE_PATH=

# Optional. How many proxies sit in front of the app (the web server on cPanel, IIS on Windows). Leave empty to trust
# every hop. Set to 1 when there is exactly one, so a visitor cannot choose the address the check-in limit sees by
# sending an X-Forwarded-For header of their own. Use 2 when something else, such as Cloudflare, is in front of the
# web server as well. A wrong number makes every visitor look like the same address, so test a check-in after changing it.
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=virtual_queue
DB_USER=queue_app
DB_PASSWORD=change-me
DB_POOL_SIZE=10
