# Ask browsers to re-check HTML pages on every visit, so an updated page is never replaced by an
# older copy kept in the browser cache. Read by Apache-style hosts and LiteSpeed (scrapcraft.dev).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Browser protections for the pages and files. The app sends the same headers for its own
  # responses; the host serves the HTML pages directly, so they need them here too.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
