<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site configuration for Lobby Check-In.
  Copy this file to the IIS site folder (for example C:\inetpub\virtualqueue-site).

  Requires: URL Rewrite, Application Request Routing (proxy enabled at server level),
  and the WebSocket Protocol feature. See DEPLOY-WINDOWS.md.

  Rules run in order:
    1. Force HTTPS: sends http:// visitors to https://.
    2. VirtualQueueNode: passes every other request to the Node app on port 3000.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="ForceHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="VirtualQueueNode" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
